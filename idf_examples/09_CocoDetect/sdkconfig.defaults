# Shared defaults for 09_CocoDetect (Arduino-as-component + ESP-DL)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000

# Load COCO weights from SD (same path as Arduino: /sdcard/models/p4/*.espdl)
CONFIG_COCO_DETECT_MODEL_IN_SDCARD=y
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y
